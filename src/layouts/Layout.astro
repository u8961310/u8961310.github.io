---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** OG 圖檔名（放在 public/og/），省略則用首頁那張 */
  ogImage?: string;
}

const {
  title,
  description = '蛋糕（Cake）的個人網站 —— 校園網路維運與 K12 資訊教育',
  ogImage = 'home.png',
} = Astro.props;

// Astro.site 來自 astro.config.mjs 的 site 設定
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(`/og/${ogImage}`, Astro.site);

const nav = [
  { href: '/teaching', label: '教學' },
  { href: '/dev', label: '技術' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === `${href}/`;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    {/* 瀏覽器 UI 顏色跟著主題走（值要對上 global.css 的 canvas） */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eef2f1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0f0e" />

    <meta name="description" content={description} />

    <meta property="og:site_name" content="蛋糕 Cake" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — 預覽圖`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <title>{title}</title>

    {/* 必須在 body 繪製前就設好主題，否則會閃一下錯誤顏色（FOUC）。
        預設亮色：第一次造訪不跟隨系統偏好，確保「清新」的第一印象。 */}
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') t = saved;
        } catch (e) {
          /* 無痕模式或封鎖 storage 時就用預設值 */
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>

  {/* flex column + main flex-1：內容短時 footer 仍貼齊視窗底部，
      不會在 footer 下方露出一條底色 */}
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      跳到主要內容
    </a>

    <header class="border-b border-line bg-surface/85 backdrop-blur">
      <nav
        class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5"
        aria-label="主導覽"
      >
        <a
          href="/"
          class="font-display text-base font-bold tracking-tight transition-colors hover:text-brand-700"
        >
          蛋糕 <span class="text-muted">Cake</span>
        </a>

        <ul class="flex items-center gap-7 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative py-1 transition-colors',
                    isActive(item.href)
                      ? 'font-medium text-ink after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-brand-600'
                      : 'text-muted hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://github.com/u8961310"
              rel="noopener"
              aria-label="GitHub 個人頁面"
              class="block text-muted transition-colors hover:text-ink"
            >
              <Icon name="github" class="h-5 w-5" />
            </a>
          </li>
          <li>
            <button
              id="theme-toggle"
              type="button"
              aria-label="切換亮色／深色模式"
              class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-muted transition-colors hover:bg-canvas hover:text-ink"
            >
              <Icon name="moon" class="h-5 w-5 dark:hidden" />
              <Icon name="sun" class="hidden h-5 w-5 dark:block" />
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-6 py-16 sm:py-20">
      <slot />
    </main>

    <footer class="mt-8 border-t border-line bg-surface">
      <div
        class="mx-auto flex max-w-4xl flex-col gap-2 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {new Date().getFullYear()} 蛋糕 Cake</p>
        <a
          href="https://github.com/u8961310"
          rel="noopener"
          class="inline-flex items-center gap-1.5 transition-colors hover:text-ink"
        >
          <Icon name="github" class="h-4 w-4" />
          u8961310
        </a>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* storage 不可用時仍會切換，只是不記住 */
        }
      });
    </script>
  </body>
</html>
