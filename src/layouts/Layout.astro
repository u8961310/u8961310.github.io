---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '陳冠廷（蛋糕）的個人網站 —— 校園網路維運與國小資訊教育' } =
  Astro.props;

const nav = [
  { href: '/teaching', label: '教學' },
  { href: '/dev', label: '技術' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path === `${href}/`;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>

    {/* 必須在 body 繪製前就設好主題，否則會閃一下錯誤顏色（FOUC）。
        預設亮色：第一次造訪不跟隨系統偏好，確保「清新」的第一印象。 */}
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') t = saved;
        } catch (e) {
          /* 無痕模式或封鎖 storage 時就用預設值 */
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>

  <body
    class="min-h-dvh bg-paper text-ink antialiased dark:bg-stone-950 dark:text-stone-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      跳到主要內容
    </a>

    <header class="border-b border-stone-200/80 dark:border-stone-800">
      <nav
        class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5"
        aria-label="主導覽"
      >
        <a
          href="/"
          class="font-display text-base font-bold tracking-tight transition-colors hover:text-brand-700 dark:hover:text-brand-500"
        >
          陳冠廷 <span class="text-stone-400 dark:text-stone-600">Cake</span>
        </a>

        <ul class="flex items-center gap-7 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative py-1 transition-colors',
                    isActive(item.href)
                      ? 'font-medium text-ink after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-brand-600 dark:text-white'
                      : 'text-stone-500 hover:text-ink dark:text-stone-400 dark:hover:text-white',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://github.com/u8961310"
              rel="noopener"
              aria-label="GitHub 個人頁面"
              class="block text-stone-400 transition-colors hover:text-ink dark:hover:text-white"
            >
              <Icon name="github" class="h-5 w-5" />
            </a>
          </li>
          <li>
            <button
              id="theme-toggle"
              type="button"
              aria-label="切換亮色／深色模式"
              class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-stone-400 transition-colors hover:bg-stone-100 hover:text-ink dark:hover:bg-stone-800 dark:hover:text-white"
            >
              <Icon name="moon" class="h-5 w-5 dark:hidden" />
              <Icon name="sun" class="hidden h-5 w-5 dark:block" />
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
      <slot />
    </main>

    <footer class="border-t border-stone-200/80 dark:border-stone-800">
      <div
        class="mx-auto flex max-w-4xl flex-col gap-2 px-6 py-8 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between dark:text-stone-400"
      >
        <p>© {new Date().getFullYear()} 陳冠廷（蛋糕）</p>
        <a
          href="https://github.com/u8961310"
          rel="noopener"
          class="inline-flex items-center gap-1.5 transition-colors hover:text-ink dark:hover:text-white"
        >
          <Icon name="github" class="h-4 w-4" />
          u8961310
        </a>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* storage 不可用時仍會切換，只是不記住 */
        }
      });
    </script>
  </body>
</html>
