---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '陳冠廷（蛋糕）的個人網站 —— 校園網路維運與國小資訊教育' } =
  Astro.props;

const nav = [
  { href: '/', label: '首頁' },
  { href: '/teaching', label: '教學' },
  { href: '/dev', label: '技術' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>

  <body class="bg-stone-50 text-stone-800 dark:bg-stone-950 dark:text-stone-200">
    <header
      class="sticky top-0 z-10 border-b border-stone-200 bg-stone-50/80 backdrop-blur dark:border-stone-800 dark:bg-stone-950/80"
    >
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
        <a href="/" class="font-black tracking-tight">蛋糕 <span class="text-stone-400">/</span> Cake</a>
        <ul class="flex gap-4 text-sm">
          {
            nav.slice(1).map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'transition hover:text-stone-950 dark:hover:text-white',
                    path.startsWith(item.href)
                      ? 'font-bold text-stone-950 dark:text-white'
                      : 'text-stone-500',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>

    <footer
      class="mx-auto max-w-3xl border-t border-stone-200 px-4 py-8 text-sm text-stone-500 dark:border-stone-800"
    >
      <p>
        © {new Date().getFullYear()} 陳冠廷（蛋糕）·
        <a
          href="https://github.com/u8961310"
          class="underline underline-offset-4 hover:text-stone-800 dark:hover:text-stone-200">GitHub</a
        >
      </p>
    </footer>
  </body>
</html>
