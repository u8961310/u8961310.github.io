---
// 互動點陣：游標（或手指）經過時點亮成 teal。
// 沒有指標輸入時改由自動漂移的虛擬光點驅動，所以手機與「還沒動滑鼠」都不是死畫面。
// prefers-reduced-motion 時只靜態畫一次，不啟動 rAF。
---

<canvas
  data-dotfield
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-10 h-full w-full"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dotfield]');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;

    if (ctx && host) {
      const SPACING = 26; // 點間距 px
      const RADIUS = 130; // 光暈影響半徑 px

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let w = 0;
      let h = 0;
      let dots: { x: number; y: number }[] = [];
      let baseRGB: [number, number, number] = [120, 130, 128];
      let brandRGB: [number, number, number] = [20, 184, 166];

      // 實際用來算光暈的座標，會平滑追向 target
      let px = -9999;
      let py = -9999;
      let targetX = -9999;
      let targetY = -9999;

      let pointerActive = false;
      let lastPointerAt = 0;
      let rafId = 0;

      function hexToRGB(hex: string): [number, number, number] | null {
        const m = hex.trim().match(/^#?([0-9a-f]{6})$/i);
        if (!m) return null;
        const n = parseInt(m[1], 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }

      function readTheme() {
        const cs = getComputedStyle(document.documentElement);
        baseRGB = hexToRGB(cs.getPropertyValue('--color-muted')) ?? baseRGB;
        brandRGB = hexToRGB(cs.getPropertyValue('--color-brand-500')) ?? brandRGB;
      }

      function layout() {
        const rect = host.getBoundingClientRect();
        w = Math.max(1, Math.round(rect.width));
        h = Math.max(1, Math.round(rect.height));

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // 讓點陣置中，邊緣留白平均
        const cols = Math.floor(w / SPACING);
        const rows = Math.floor(h / SPACING);
        const offX = (w - (cols - 1) * SPACING) / 2;
        const offY = (h - (rows - 1) * SPACING) / 2;

        dots = [];
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            dots.push({ x: offX + c * SPACING, y: offY + r * SPACING });
          }
        }
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);
        for (const d of dots) {
          const dx = d.x - px;
          const dy = d.y - py;
          const dist = Math.hypot(dx, dy);

          let t = dist < RADIUS ? 1 - dist / RADIUS : 0;
          t *= t; // 收斂得快一點，光暈邊界才不會糊

          const radius = 1.15 + t * 2.3;
          const alpha = 0.28 + t * 0.72;
          const cr = Math.round(baseRGB[0] + (brandRGB[0] - baseRGB[0]) * t);
          const cg = Math.round(baseRGB[1] + (brandRGB[1] - baseRGB[1]) * t);
          const cb = Math.round(baseRGB[2] + (brandRGB[2] - baseRGB[2]) * t);

          ctx.beginPath();
          ctx.arc(d.x, d.y, radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${cr},${cg},${cb},${alpha})`;
          ctx.fill();
        }
      }

      // 沒有真實指標時，讓一個虛擬光點沿 Lissajous 路徑漂移
      function autoTarget(now: number) {
        const t = now / 1000;
        targetX = w * (0.5 + 0.34 * Math.sin(t * 0.37));
        targetY = h * (0.5 + 0.32 * Math.sin(t * 0.53 + 1.1));
      }

      function frame(now: number) {
        // 指標停手 2.5 秒後交還給自動漂移，畫面不會停在死狀態
        if (!pointerActive || now - lastPointerAt > 2500) autoTarget(now);

        px += (targetX - px) * 0.08;
        py += (targetY - py) * 0.08;

        draw();
        rafId = requestAnimationFrame(frame);
      }

      function start() {
        if (rafId) return;
        rafId = requestAnimationFrame(frame);
      }

      function stop() {
        if (!rafId) return;
        cancelAnimationFrame(rafId);
        rafId = 0;
      }

      function applyMotionMode() {
        stop();
        if (reduceMotion.matches) {
          // 靜態：不追游標、不跑迴圈，只畫一次基準點陣
          px = -9999;
          py = -9999;
          draw();
        } else {
          start();
        }
      }

      host.addEventListener(
        'pointermove',
        (e) => {
          if (reduceMotion.matches) return;
          const rect = host.getBoundingClientRect();
          targetX = e.clientX - rect.left;
          targetY = e.clientY - rect.top;
          pointerActive = true;
          lastPointerAt = performance.now();
        },
        { passive: true }
      );

      host.addEventListener('pointerleave', () => {
        pointerActive = false;
      });

      // 分頁不可見時停掉 rAF，不要空耗電力
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else applyMotionMode();
      });

      readTheme();
      layout();
      // 初始位置放在中央，第一幀不會從角落飛進來
      px = w / 2;
      py = h / 2;
      applyMotionMode();

      new ResizeObserver(() => {
        layout();
        if (reduceMotion.matches) draw();
      }).observe(host);

      // 主題切換時重讀色票
      new MutationObserver(() => {
        readTheme();
        if (reduceMotion.matches) draw();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      reduceMotion.addEventListener('change', applyMotionMode);
    }
  }
</script>
