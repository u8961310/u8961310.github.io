---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/', label: '首頁' },
  { href: '/teaching', label: '教學' },
  { href: '/dev', label: '技術' },
];
---

<Layout title="找不到頁面 — 蛋糕 Cake" description="這個網址沒有對應的頁面">
  <section class="py-8">
    <p class="mb-4 font-display text-xs font-medium uppercase tracking-[0.18em] text-brand-700">
      404
    </p>
    <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">找不到這一頁</h1>
    <p class="mb-8 max-w-prose text-muted">
      網址可能打錯了，或這個頁面已經搬走。下面幾個入口應該找得到你要的東西。
    </p>

    <ul class="flex flex-wrap gap-3">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2.5 text-sm font-medium shadow-sm transition-colors duration-200 hover:border-brand-500 hover:text-brand-700"
            >
              {l.label}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
