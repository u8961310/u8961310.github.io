---
import Layout from '../layouts/Layout.astro';

// TODO(P2)：這段定位文字是草稿，請改成你自己的說法
const tagline = '校園網路維運 × 國小資訊教育';
const intro = '用工程的方法做教學的事，也用教學的角度寫程式。';

const tracks = [
  {
    href: '/teaching',
    emoji: '🎮',
    title: '教學',
    desc: '國小資訊課教材、互動遊戲、教學理念',
    meta: '21 個互動單元已上線',
    accent: 'hover:border-teach-500',
  },
  {
    href: '/dev',
    emoji: '⚙️',
    title: '技術',
    desc: '工具開發、自動化、校園系統整合',
    meta: 'GitHub 公開專案',
    accent: 'hover:border-dev-500',
  },
];
---

<Layout title="陳冠廷（蛋糕）">
  <section class="mb-14">
    <h1 class="mb-3 text-3xl font-black tracking-tight sm:text-4xl">陳冠廷<span
        class="ml-2 text-xl font-medium text-stone-400">蛋糕</span
      ></h1>
    <p class="text-lg font-medium text-stone-600 dark:text-stone-300">{tagline}</p>
    <p class="mt-1 text-stone-500">{intro}</p>
  </section>

  <section class="grid gap-4 sm:grid-cols-2">
    {
      tracks.map((t) => (
        <a
          href={t.href}
          class:list={[
            'group rounded-2xl border border-stone-200 bg-white p-6 transition',
            'hover:-translate-y-0.5 hover:shadow-lg',
            'dark:border-stone-800 dark:bg-stone-900',
            t.accent,
          ]}
        >
          <div class="mb-3 text-3xl">{t.emoji}</div>
          <h2 class="mb-1 text-xl font-bold">{t.title}</h2>
          <p class="text-sm text-stone-600 dark:text-stone-400">{t.desc}</p>
          <p class="mt-4 text-xs font-medium text-stone-400">{t.meta} →</p>
        </a>
      ))
    }
  </section>
</Layout>
