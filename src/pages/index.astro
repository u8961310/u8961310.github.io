---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DotField from '../components/DotField.astro';

// TODO(P2)：這段定位文字是草稿，請改成你自己的說法
const tagline = '校園網路維運 × K12 資訊教育';
const intro =
  '在大學管網路與系統，也替 K12 的孩子做資訊課教材。用工程的方法做教學的事，也用教學的角度寫程式。';

const tracks = [
  {
    href: '/teaching',
    icon: 'academic-cap' as const,
    label: '教學',
    desc: 'K12 資訊課教材、互動遊戲、教學理念',
    meta: '21 個互動單元已上線',
  },
  {
    href: '/dev',
    icon: 'code-bracket' as const,
    label: '技術',
    desc: '工具開發、流程自動化、校園系統整合',
    meta: 'GitHub 公開專案',
  },
];
---

<Layout title="蛋糕 Cake">
  {/* isolate 建立堆疊脈絡，讓點陣 canvas 的 -z-10 只退到本區塊底層，不會跑到 body 後面。
      -mx-6 px-6 讓點陣延伸到左右留白，視覺上比切齊內容寬度更開闊。 */}
  <section class="relative isolate -mx-6 mb-14 px-6 py-12 sm:py-16">
    <DotField />

    <div class="relative">
      <p class="mb-5 font-display text-xs font-medium uppercase tracking-[0.18em] text-brand-700">
        Cake
      </p>

      <h1 class="mb-5 text-4xl font-bold tracking-tight sm:text-5xl">蛋糕</h1>

      <p class="mb-3 text-lg font-medium sm:text-xl">{tagline}</p>

      <p class="max-w-prose text-muted">{intro}</p>
    </div>
  </section>

  <section aria-labelledby="tracks-heading">
    <h2 id="tracks-heading" class="sr-only">主要內容分區</h2>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        tracks.map((t) => (
          <a
            href={t.href}
            class="group flex cursor-pointer flex-col rounded-xl border border-line bg-surface p-7 shadow-sm transition-[border-color,box-shadow] duration-200 hover:border-brand-500 hover:shadow-md focus-visible:border-brand-500"
          >
            <span class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-700 transition-colors duration-200 group-hover:bg-brand-100 dark:bg-brand-500/10 dark:group-hover:bg-brand-500/20">
              <Icon name={t.icon} class="h-5 w-5" />
            </span>

            <h3 class="mb-1.5 text-lg font-bold">{t.label}</h3>

            <p class="mb-6 text-sm text-muted">{t.desc}</p>

            <span class="mt-auto inline-flex items-center gap-2 text-xs font-medium text-muted transition-colors duration-200 group-hover:text-brand-700">
              {t.meta}
              <Icon
                name="arrow-right"
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none"
              />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
