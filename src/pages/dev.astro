---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { fetchRepos, groupRepos, LANG_COLOR } from '../lib/github';

// build 時執行；失敗會自動回落到 committed 快照（見 lib/github.ts）
const { repos, source } = await fetchRepos();
const { featured, recent, early, counts } = groupRepos(repos);

const fmt = (iso: string) => iso.slice(0, 7).replace('-', '/');
---

<Layout title="技術 — 蛋糕 Cake" description="工具開發、流程自動化與校園系統整合的公開專案" ogImage="dev.png">
  <header class="mb-12">
    <p class="mb-4 font-display text-xs font-medium uppercase tracking-[0.18em] text-brand-700">
      Engineering
    </p>
    <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">技術</h1>
    <p class="max-w-prose text-muted">
      解決實際問題的工具與自動化：公文下載、PDF 處理、影片備份、校園系統整合。
    </p>
    <p class="mt-2 text-sm text-muted">共 {counts.own} 個公開專案，清單於建置時直接讀 GitHub。</p>
  </header>

  {/* ── 精選 ── */}
  <section class="mb-14">
    <h2 class="mb-5 font-display text-xs font-medium uppercase tracking-[0.18em] text-muted">
      精選
    </h2>

    <div class="grid gap-4">
      {
        featured.map((f) => (
          <article class="group rounded-xl border border-line bg-surface p-6 shadow-sm transition-[border-color,box-shadow] duration-200 hover:border-brand-500 hover:shadow-md">
            <div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="text-lg font-bold">
                <a href={f.data.url} rel="noopener" class="hover:text-brand-700">
                  {f.title ?? f.data.name}
                </a>
              </h3>
              <code class="font-mono text-xs text-muted">{f.data.name}</code>
            </div>

            <p class="mb-4 max-w-prose text-sm text-muted">{f.blurb}</p>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted">
              {f.data.language && (
                <span class="inline-flex items-center gap-1.5">
                  <span
                    class="h-2.5 w-2.5 rounded-full"
                    style={`background:${LANG_COLOR[f.data.language] ?? 'var(--color-brand-500)'}`}
                  />
                  {f.data.language}
                </span>
              )}
              {f.data.stars > 0 && <span>★ {f.data.stars}</span>}
              <span>更新於 {fmt(f.data.pushedAt)}</span>

              <span class="ml-auto flex items-center gap-4">
                {f.liveUrl && (
                  <a
                    href={f.liveUrl}
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 font-medium text-brand-700 hover:underline"
                  >
                    {f.liveLabel ?? '線上版本'}
                    <Icon name="arrow-right" class="h-3.5 w-3.5" />
                  </a>
                )}
                <a
                  href={f.data.url}
                  rel="noopener"
                  aria-label={`${f.data.name} 原始碼`}
                  class="inline-flex items-center gap-1.5 hover:text-ink"
                >
                  <Icon name="github" class="h-3.5 w-3.5" />
                  原始碼
                </a>
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ── 其他近期專案 ── */}
  <section class="mb-14">
    <h2 class="mb-5 font-display text-xs font-medium uppercase tracking-[0.18em] text-muted">
      其他專案
    </h2>

    <ul class="grid gap-px overflow-hidden rounded-xl bg-line ring-1 ring-line sm:grid-cols-2">
      {
        recent.map((r) => (
          <li>
            <a
              href={r.url}
              rel="noopener"
              class="flex h-full flex-col bg-surface p-4 transition-colors duration-200 hover:bg-brand-50 dark:hover:bg-brand-500/10"
            >
              <span class="mb-1 font-mono text-sm font-medium">{r.name}</span>
              {r.description && <span class="mb-2 text-xs text-muted">{r.description}</span>}
              <span class="mt-auto flex items-center gap-3 pt-2 text-xs text-muted">
                {r.language && (
                  <span class="inline-flex items-center gap-1.5">
                    <span
                      class="h-2 w-2 rounded-full"
                      style={`background:${LANG_COLOR[r.language] ?? 'var(--color-brand-500)'}`}
                    />
                    {r.language}
                  </span>
                )}
                <span>{fmt(r.pushedAt)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ── 早期作品（預設收合）── */}
  {
    early.length > 0 && (
      <details class="group rounded-xl border border-line bg-surface px-6 py-4 shadow-sm">
        <summary class="cursor-pointer list-none text-sm font-medium marker:content-none">
          <span class="inline-flex items-center gap-2">
            早期作品
            <span class="text-xs font-normal text-muted">
              {early.length} 個 · {early[early.length - 1].pushedAt.slice(0, 4)}–
              {early[0].pushedAt.slice(0, 4)}
            </span>
            <Icon
              name="arrow-right"
              class="h-4 w-4 text-muted transition-transform duration-200 group-open:rotate-90 motion-reduce:transform-none"
            />
          </span>
        </summary>

        <ul class="mt-4 space-y-2 border-t border-line pt-4 text-sm">
          {early.map((r) => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <a href={r.url} rel="noopener" class="font-mono text-sm hover:text-brand-700">
                {r.name}
              </a>
              <span class="text-xs text-muted">{r.pushedAt.slice(0, 4)}</span>
              {r.description && <span class="text-xs text-muted">{r.description}</span>}
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    source === 'snapshot' && (
      <p class="mt-8 text-xs text-muted">
        （此清單來自建置時的快照，GitHub API 當下取用失敗）
      </p>
    )
  }
</Layout>
