---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="技術 — 蛋糕 Cake" description="工具開發、流程自動化與校園系統整合的公開專案">
  <header class="mb-10">
    <p class="mb-4 font-display text-xs font-medium uppercase tracking-[0.18em] text-brand-700">
      Engineering
    </p>
    <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">技術</h1>
    <p class="max-w-prose text-muted">
      解決實際問題的工具與自動化：公文下載、PDF 處理、影片備份、校園系統整合。
    </p>
  </header>

  <div class="rounded-xl border border-line bg-surface p-8 shadow-sm">
    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-muted">建置中 · P1</p>
    <p class="mb-6">精選專案策展 · GitHub API 自動列表</p>
    <a
      href="https://github.com/u8961310"
      rel="noopener"
      class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white transition-colors duration-200 hover:bg-brand-700 dark:text-stone-950"
    >
      <Icon name="github" class="h-4 w-4" />
      先去看 GitHub
    </a>
  </div>
</Layout>
